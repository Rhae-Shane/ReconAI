    "ioredis": "^6.0.0",
    "lucide-react": "^1.23.0",
    "motion": "^13.2.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
