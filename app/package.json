{
  "name": "reconai",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "dev:webpack": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "node -e \"try{require('husky')}catch(e){}\" || true",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/generate-theme-presets.ts",
    "verify:ops": "tsx src/scripts/verify-ops.ts",
    "verify:reconcile": "tsx src/scripts/verify-reconcile.ts",
    "seed:close-runs": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs src/scripts/seed-close-runs.ts",
    "test": "vitest run",
    "benchmark": "npm --prefix ../harness run benchmark",
    "worker": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs src/worker/index.ts"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
