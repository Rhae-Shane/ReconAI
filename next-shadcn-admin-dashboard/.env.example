# Copy to `.env.local` and fill in from your Supabase project (Settings → API).
# These are the public anon credentials — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ------------------------------------------------------------------
# Upstash Redis (optional — managed, free tier, no self-hosting).
# The Controller falls back to its in-memory demo store when these are
# unset. Set them to switch on the durable Redis/BullMQ/LangGraph layer:
#   - two REST vars power the app-level store + rate limiter
#     (from Upstash Console → your database → "REST API" tab — serverless).
#   - REDIS_URL is the ioredis/TCP endpoint used by BullMQ (queue) and the
#     LangGraph Redis checkpointer (from the database's "Connect" — not REST).
# ------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=YOUR-UPSTASH-REST-URL
UPSTASH_REDIS_REST_TOKEN=YOUR-UPSTASH-REST-TOKEN
REDIS_URL=YOUR-UPSTASH-IOREDIS-URI

# ------------------------------------------------------------------
# OpenAI (optional — live residual judge, settlement chat, embeddings).
# The Controller falls back to HeuristicJudge + n-gram similarity when unset.
# Chat and embeddings share this one key. Do NOT add Anthropic or a separate
# embeddings key.
# ------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional alias used by some older env files:
# CHATGPT_API_KEY=

# ------------------------------------------------------------------
# Razorpay (server-only; NEVER prefix with NEXT_PUBLIC_).
# Dashboard → API Keys (Test mode) + Dashboard → Webhooks.
# When unset the close loop stays on CSV / the synthetic 81-record batch.
# Webhook URL: POST /api/webhooks/razorpay
#   events: payment.captured, refund.processed, settlement.processed
# Pull live test data: POST /api/close/razorpay/sync
# ------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
